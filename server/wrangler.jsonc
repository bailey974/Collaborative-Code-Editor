{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collab-code-editor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // The built web app (web/dist) is served from this same Worker, so the site,
  // the REST API and the collaboration WebSockets all share one origin.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collab-db",
      // Replace with the id printed by `npx wrangler d1 create collab-db`.
      // Any value works for local development.
      "database_id": "4063807c-d8e6-439f-b049-8fc594d3ea4f",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },

  // Free plan requires SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Public Google Drive config, served to the browser by GET /api/config.
  // Neither value is a secret: an OAuth *client id* and a browser API key that
  // is locked to this site's origin and the Picker API (see web/.env.example).
  // Leave empty to hide the Drive buttons.
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_API_KEY": ""
  },

  // Daily sweep of expired guest accounts and the rooms they host.
  "triggers": { "crons": ["17 3 * * *"] },

  "observability": { "enabled": true }
}
