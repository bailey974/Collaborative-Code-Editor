# Client env for the web app. All VITE_* values are PUBLIC (baked into the
# bundle) — never put secrets here. Copy to `.env.local` and fill in.

# Override the API / collaboration origins (default: same origin as the page).
# VITE_API_BASE_URL=
# VITE_COLLAB_URL=

# Google Drive integration (optional). The app normally gets the Google config
# at runtime from the Worker (GOOGLE_CLIENT_ID / GOOGLE_API_KEY in
# server/wrangler.jsonc "vars", or server/.dev.vars locally), so you don't need
# these. Set them only to bake values into a build served by some other host.
# Setup steps (all free): see "Google Drive setup" in server/README.md.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
