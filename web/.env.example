# Client env for the web app. All VITE_* values are PUBLIC (baked into the
# bundle) — never put secrets here. Copy to `.env.local` and fill in.

# Override the API / collaboration origins (default: same origin as the page).
# VITE_API_BASE_URL=
# VITE_COLLAB_URL=

# Google Drive integration (optional). When BOTH are set, the file explorer
# gains "Import files/folders from Drive" and "Save to Drive". Both values are
# public (baked into the bundle) and free to create in the Google Cloud Console.
#
# One-time setup (https://console.cloud.google.com):
#   1. Create/pick a project.
#   2. APIs & Services > Enabled APIs > enable "Google Picker API" AND
#      "Google Drive API".
#   3. APIs & Services > OAuth consent screen: User type "External"; add your
#      Google account under "Test users" (no app verification needed while in
#      Testing, because we only use the drive.file scope).
#   4. Credentials > Create credentials > OAuth client ID > "Web application".
#      Under "Authorised JavaScript origins" add every origin you load the app
#      from, e.g. http://127.0.0.1:1420 (dev) and
#      https://collab-code-editor.<subdomain>.workers.dev (prod). Copy the
#      Client ID into VITE_GOOGLE_CLIENT_ID below.
#   5. Credentials > Create credentials > API key. Copy it into
#      VITE_GOOGLE_API_KEY below. (Optional: restrict it to those origins and
#      to the Picker API.)
#
# Then copy this file to .env.local, fill both in, and restart `npm run dev`
# (for prod, they must be set before `npm run build`).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
