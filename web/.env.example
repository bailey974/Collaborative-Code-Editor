# Client env for the web app. All VITE_* values are PUBLIC (baked into the
# bundle) — never put secrets here. Copy to `.env.local` and fill in.

# Override the API / collaboration origins (default: same origin as the page).
# VITE_API_BASE_URL=
# VITE_COLLAB_URL=

# Google Drive integration (optional). When both are set, the file explorer
# gains "Import from Drive" / "Save to Drive". Both are free to create in the
# Google Cloud Console — see server/README.md for setup steps.
#   - OAuth 2.0 Client ID (type: Web application). Add your app origins to
#     "Authorised JavaScript origins" (e.g. http://127.0.0.1:1420 for dev and
#     https://collab-code-editor.<subdomain>.workers.dev for prod).
#   - Browser API key, required by the Google Picker.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
